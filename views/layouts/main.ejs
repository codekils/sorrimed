<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <meta
      name="description"
      content="<%= typeof description !== 'undefined' ? description : 'SorriMed: odontologia com cuidado próximo.' %>"
    />
    <meta name="theme-color" content="#957B53" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="/css/foundation.css" />
    <link rel="stylesheet" href="/css/redesign.css" />
  </head>
  <body>
    <% const layoutContact = typeof contact !== 'undefined' ? contact : {}; %>
    <% const whatsappUrl = layoutContact.whatsapp ? `https://wa.me/${String(layoutContact.whatsapp).replace(/[^\d]/g, '')}` : ''; %>
    <%- include('../components/header', { contact: layoutContact, whatsappUrl }) %>
    <main><%- include('../pages/' + page, { whatsappUrl }) %></main>
    <%- include('../components/footer', { contact: layoutContact, whatsappUrl }) %>
    <script src="/js/foundation.js" defer></script>
  </body>
</html>
