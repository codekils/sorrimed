<% const homeWhatsappUrl = typeof whatsappUrl !== 'undefined' ? whatsappUrl : ''; %>

<section class="home-hero hero-slider" aria-roledescription="carousel" aria-label="Destaques da SorriMed">
  <div class="hero-slides">
    <article class="hero-slide hero-slide-light is-active" data-hero-slide aria-hidden="false">
      <div class="container home-hero-grid">
        <div class="home-hero-copy">
          <p class="eyebrow">SorriMed <span aria-hidden="true">/</span> odontologia próxima</p>
          <h1 id="hero-title">Seu sorriso merece <strong>um cuidado especial.</strong></h1>
          <p class="hero-lead"><%= home.clinic.description %></p>
          <div class="hero-actions"><% if (homeWhatsappUrl) { %><a class="button button-primary" href="<%= homeWhatsappUrl %>" target="_blank" rel="noopener noreferrer">Conversar com a equipe <span aria-hidden="true">↗</span></a><% } %><a class="button button-quiet" href="/servicos">Conhecer os cuidados <span aria-hidden="true">→</span></a></div>
          <div class="hero-proof"><span class="proof-mark" aria-hidden="true">✦</span><span>Escuta atenta, tecnologia e tranquilidade em cada encontro.</span></div>
        </div>
        <div class="home-hero-media"><div class="hero-media-frame"><video autoplay muted loop playsinline preload="auto" aria-label="Profissional de odontologia atendendo uma paciente" width="640" height="800"><source src="/images/slider-home/video-one.mp4" type="video/mp4">Seu navegador não suporta vídeos HTML5.</video></div><div class="hero-float-note"><span>01</span><strong>Seu sorriso<br>no centro.</strong></div></div>
      </div>
    </article>
    <article class="hero-slide hero-slide-blue" data-hero-slide aria-hidden="true">
      <div class="container home-hero-grid">
        <div class="home-hero-copy"><p class="eyebrow">Cuidado que acompanha</p><h2>Mais clareza para<br><strong>decidir com calma.</strong></h2><p class="hero-lead">A gente explica cada possibilidade para você se sentir seguro em todas as etapas.</p><div class="hero-actions"><a class="button button-light" href="/sobre">Conhecer a clínica <span aria-hidden="true">↗</span></a><% if (homeWhatsappUrl) { %><a class="button button-quiet" href="<%= homeWhatsappUrl %>" target="_blank" rel="noopener noreferrer">Falar com a equipe <span aria-hidden="true">↗</span></a><% } %></div><div class="hero-proof"><span class="proof-mark" aria-hidden="true">02</span><span>Presença e informação em cada conversa.</span></div></div>
        <div class="home-hero-media"><div class="hero-media-frame"><video autoplay muted loop playsinline preload="metadata" aria-label="Dentista conversando com paciente durante atendimento" width="640" height="800"><source src="/images/slider-home/video-two.mp4" type="video/mp4">Seu navegador não suporta vídeos HTML5.</video></div><div class="hero-float-note"><span>02</span><strong>Conversas que<br>tranquilizam.</strong></div></div>
      </div>
    </article>
    <article class="hero-slide hero-slide-soft" data-hero-slide aria-hidden="true">
      <div class="container home-hero-grid">
        <div class="home-hero-copy"><p class="eyebrow">Um espaço para você</p><h2>Seu tempo também<br><strong>faz parte do cuidado.</strong></h2><p class="hero-lead">Um ambiente acolhedor, equipe próxima e uma experiência pensada para deixar tudo mais leve.</p><div class="hero-actions"><a class="button button-primary" href="/localizacao">Conhecer o espaço <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/servicos">Ver serviços <span aria-hidden="true">→</span></a></div><div class="hero-proof"><span class="proof-mark" aria-hidden="true">03</span><span>Tranquilidade desde a chegada.</span></div></div>
        <div class="home-hero-media"><div class="hero-media-frame"><video autoplay muted loop playsinline preload="metadata" aria-label="Profissional de odontologia sorrindo em uma clínica" width="640" height="800"><source src="/images/slider-home/video-three.mp4" type="video/mp4">Seu navegador não suporta vídeos HTML5.</video></div><div class="hero-float-note"><span>03</span><strong>Leveza em<br>cada detalhe.</strong></div></div>
      </div>
    </article>
  </div>
  <div class="hero-slider-controls" aria-label="Controles dos destaques"><button class="hero-arrow hero-prev" type="button" aria-label="Destaque anterior">←</button><div class="hero-dots"><button class="hero-dot is-active" type="button" aria-label="Ir para destaque 1" aria-current="true"></button><button class="hero-dot" type="button" aria-label="Ir para destaque 2" aria-current="false"></button><button class="hero-dot" type="button" aria-label="Ir para destaque 3" aria-current="false"></button></div><button class="hero-arrow hero-next" type="button" aria-label="Próximo destaque">→</button></div>
</section>

<section class="trust-strip" aria-label="Diferenciais da clínica"><div class="container trust-grid"><% [...(home.clinic.values || []), ...(home.clinic.differentials || [])].slice(0, 4).forEach((highlight, index) => { %><div class="trust-item"><span>0<%= index + 1 %></span><strong><%= highlight %></strong></div><% }) %></div></section>

<section class="home-section home-services" aria-labelledby="home-services-title"><div class="container"><div class="section-intro-row"><div><p class="eyebrow">01 / Nossos cuidados</p><h2 id="home-services-title">Tudo começa com<br><strong>um bom cuidado.</strong></h2></div><a class="text-link" href="/servicos">Ver todos os serviços <span aria-hidden="true">↗</span></a></div><% if (home.services.length) { %><div class="home-service-list"><% home.services.forEach((service, index) => { %><a class="home-service-row" href="/servicos"><span class="home-service-index">0<%= index + 1 %></span><span class="home-service-name"><%= service.name %></span><span class="home-service-description"><%= service.description %></span><span class="row-arrow" aria-hidden="true">↗</span></a><% }) %></div><% } else { %><p class="empty-state">Em breve, apresentaremos nossos principais cuidados.</p><% } %></div></section>

<section class="home-section home-about" aria-labelledby="home-about-title"><div class="container editorial-grid"><div class="editorial-media"><img src="/images/clinic/clinic-light2.jpg" alt="Luz natural em uma sala da clínica SorriMed" width="640" height="420" loading="lazy"><span class="image-caption">Um espaço pensado<br><strong>para você.</strong></span></div><div class="editorial-copy"><p class="eyebrow">02 / A clínica</p><h2 id="home-about-title">Mais do que tratar,<br><strong>estar presente.</strong></h2><p class="large-copy"><%= home.clinic.about %></p><p><%= home.clinic.mission %></p><a class="text-link" href="/sobre">Conheça a SorriMed <span aria-hidden="true">↗</span></a></div></div></section>

<section class="home-section home-team" aria-labelledby="home-team-title"><div class="container"><div class="section-intro-row"><div><p class="eyebrow">03 / Quem cuida</p><h2 id="home-team-title">Pessoas que cuidam<br><strong>de pessoas.</strong></h2></div><a class="text-link" href="/profissionais">Conhecer a equipe <span aria-hidden="true">↗</span></a></div><% if (home.professionals.length) { %><div class="team-feature-grid"><% home.professionals.forEach((professional, index) => { %><article class="team-feature team-feature-<%= index + 1 %>"><div class="team-avatar"><% if (professional.photo) { %><img src="<%= professional.photo %>" alt="Foto de <%= professional.name %>" loading="lazy"><% } else { %><span><%= professional.name.split(' ').slice(-2).map((part) => part[0]).join('') %></span><% } %><i aria-hidden="true">✦</i></div><p class="team-specialty"><%= professional.specialty %></p><h3><%= professional.name %></h3><p><%= professional.description %></p></article><% }) %></div><% } else { %><p class="empty-state">Nossa equipe será apresentada em breve.</p><% } %></div></section>

<section class="home-section home-testimonials" aria-labelledby="home-testimonials-title"><div class="container testimonial-layout"><div><p class="eyebrow">04 / Experiências</p><h2 id="home-testimonials-title">O cuidado que<br><strong>fica com você.</strong></h2><p class="section-intro-copy">Cada pessoa tem uma história. É por isso que escutar vem antes de qualquer plano.</p><div class="testimonial-controls"><button class="carousel-button" type="button" data-testimonial-prev aria-label="Experiência anterior">←</button><button class="carousel-button" type="button" data-testimonial-next aria-label="Próxima experiência">→</button></div></div><% if (home.testimonials.length) { %><div class="testimonial-viewport"><div class="testimonial-track"><% home.testimonials.forEach((testimonial) => { %><figure class="testimonial-card"><blockquote>“<%= testimonial.text %>”</blockquote><figcaption><span class="quote-avatar" aria-hidden="true"><%= testimonial.name.slice(0, 1) %></span><span><strong><%= testimonial.name %></strong><small>Paciente SorriMed</small></span></figcaption></figure><% }) %></div></div><% } else { %><p class="empty-state">As experiências de nossos pacientes aparecerão aqui.</p><% } %></div></section>

<% if (home.media.length) { %><section class="home-section home-media" aria-labelledby="home-media-title"><div class="container media-layout"><div><p class="eyebrow">05 / O espaço</p><h2 id="home-media-title">Um ambiente que<br><strong>acolhe primeiro.</strong></h2><p class="section-intro-copy">Detalhes pensados para que você se sinta à vontade desde a chegada.</p></div><div class="media-grid"><% home.media.forEach((item) => { %><figure class="media-card"><img src="<%= item.url %>" alt="<%= item.description %>" loading="lazy" width="640" height="420"><figcaption><%= item.title %></figcaption></figure><% }) %></div></div></section><% } %>

<section class="home-section home-plans" aria-labelledby="home-plans-title"><div class="container plans-band"><div><p class="eyebrow">06 / Convênios</p><h2 id="home-plans-title">Cuidado que cabe<br><strong>na sua rotina.</strong></h2></div><div class="plans-summary"><p>Confira os planos e converse com a equipe para entender as possibilidades do seu atendimento.</p><div class="plan-chips"><% (home.insurancePlans || []).slice(0, 3).forEach((plan) => { %><span><%= plan.name %></span><% }) %></div><a class="text-link" href="/convenios">Ver convênios <span aria-hidden="true">↗</span></a></div></div></section>

<section class="home-section home-location" aria-labelledby="home-location-title"><div class="container location-band"><div class="location-copy"><p class="eyebrow">07 / Onde estamos</p><h2 id="home-location-title">Perto de você,<br><strong>com calma.</strong></h2><p class="location-city">Santa Albertina, São Paulo</p><address><%= home.location.address %></address><div class="location-actions"><a class="button button-primary" href="<%= home.location.mapUrl %>" target="_blank" rel="noopener noreferrer">Abrir no Google Maps <span aria-hidden="true">↗</span></a><% if (homeWhatsappUrl) { %><a class="button button-quiet" href="<%= homeWhatsappUrl %>" target="_blank" rel="noopener noreferrer">Chamar no WhatsApp <span aria-hidden="true">↗</span></a><% } %></div></div><div class="location-map"><iframe title="Mapa de Santa Albertina, São Paulo" src="https://www.google.com/maps?q=Santa+Albertina,+S%C3%A3o+Paulo,+Brasil&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div></div></section>

<section class="home-cta" aria-labelledby="home-cta-title"><div class="container home-cta-inner"><div><p class="eyebrow">08 / Vamos conversar</p><h2 id="home-cta-title">Seu próximo passo<br><strong>pode ser simples.</strong></h2></div><% if (homeWhatsappUrl) { %><a class="button button-light" href="<%= homeWhatsappUrl %>" target="_blank" rel="noopener noreferrer">Chamar no WhatsApp <span aria-hidden="true">↗</span></a><% } %></div></section>
