<section class="professionals-page section-light" aria-labelledby="professionals-page-title">
  <div class="container professionals-page-shell">
    <div class="section-heading professionals-header">
      <div>
        <p class="section-kicker">03 / Profissionais</p>
        <h1 id="professionals-page-title">Quem está ao seu lado.</h1>
      </div>
      <a class="button button-primary" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer">Falar com a equipe <span aria-hidden="true">↗</span></a>
    </div>

    <% if (professionals && professionals.length) { %>
      <% const professionalImages = [
        'https://images.pexels.com/photos/3845983/pexels-photo-3845983.jpeg?auto=compress&cs=tinysrgb&w=900',
        'https://images.pexels.com/photos/3762452/pexels-photo-3762452.jpeg?auto=compress&cs=tinysrgb&w=900',
        'https://images.pexels.com/photos/5355851/pexels-photo-5355851.jpeg?auto=compress&cs=tinysrgb&w=900'
      ]; %>
      <div class="professional-grid professionals-grid" aria-live="polite">
        <% professionals.forEach((professional, index) => { %>
          <article class="professional-card professionals-card">
            <div class="professional-photo <%= ['coral', 'teal', 'gold'][index % 3] || 'teal' %>" aria-label="Representação de <%= professional.name %>" role="img">
              <% if (professional.photo) { %>
                <img src="<%= professional.photo %>" alt="<%= professional.name %>" loading="lazy">
              <% } else { %>
                <img src="<%= professionalImages[index % professionalImages.length] %>" alt="Representação de <%= professional.name %>" loading="lazy">
              <% } %>
              <i aria-hidden="true">✦</i>
            </div>
            <p class="professional-specialty"><%= professional.specialty %></p>
            <h2><%= professional.name %></h2>
            <p><%= professional.description %></p>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state" role="status" aria-live="polite">
        Nossa equipe será apresentada em breve.
      </div>
    <% } %>

    <section class="professionals-cta" aria-labelledby="professionals-cta-title">
      <div>
        <p class="section-kicker">Atendimento</p>
        <h2 id="professionals-cta-title">Converse com a equipe sobre o cuidado ideal para você.</h2>
      </div>
      <a class="button button-primary" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer">Chamar no WhatsApp <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</section>
